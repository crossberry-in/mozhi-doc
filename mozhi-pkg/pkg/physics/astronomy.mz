# ============================================================
# Mozhi Physics Library — Astronomy (v1.0.0)
# Orbital period, luminosity, stellar mass
# All inputs/outputs in SI units (s, W, kg, m, m/s)
# ============================================================

import constants from "physics/constants.mz"
import errors from "physics/errors.mz"

fn _sqrt(n) {
    if n <= 0 {
        return 0.0
    }
    x = n
    prev = 0.0
    while abs(x - prev) > 0.0000000001 {
        prev = x
        x = (x + n / x) / 2.0
    }
    return x
}

# Local cube root: uses log-based approach for stability
fn _cbrt(n) {
    if n == 0 {
        return 0.0
    }
    sign = 1.0
    if n < 0 {
        sign = -1.0
        n = -n
    }
    # Newton-Raphson for cube root: x_{n+1} = (2·x + n/x²) / 3
    x = n
    if x < 1 {
        x = 1.0
    }
    prev = 0.0
    while abs(x - prev) > 0.0000000001 {
        prev = x
        x = (2.0 * x + n / (x * x)) / 3.0
    }
    return sign * x
}

# ------------------------------------------------------------
# Orbital Period (Kepler's Third Law)
# ------------------------------------------------------------

# Kepler's third law: T² = (4π² / G·M) · a³
# central_mass (kg), semi_major_axis (m) → period (s)
fn orbitalPeriod(central_mass, semi_major_axis) {
    if central_mass == 0 {
        return errors.err_zero("central_mass")
    }
    if central_mass < 0 {
        return errors.err_negative("central_mass")
    }
    if semi_major_axis < 0 {
        return errors.err_negative("semi_major_axis")
    }
    return 2.0 * constants.PI * _sqrt(semi_major_axis * semi_major_axis * semi_major_axis / (constants.GRAVITATIONAL_CONSTANT * central_mass))
}

# Orbital period (Earth-orbiting satellite): uses EARTH_MASS
# semi_major_axis (m) → period (s)
fn earth_orbital_period(semi_major_axis) {
    return orbitalPeriod(constants.EARTH_MASS, semi_major_axis)
}

# ------------------------------------------------------------
# Semi-Major Axis (inverse Kepler)
# ------------------------------------------------------------

# From Kepler's third law: a = (G·M·T² / (4π²))^(1/3)
# central_mass (kg), period (s) → semi-major axis (m)
fn semi_major_axis(central_mass, period) {
    if central_mass == 0 {
        return errors.err_zero("central_mass")
    }
    if period < 0 {
        return errors.err_negative("period")
    }
    val = constants.GRAVITATIONAL_CONSTANT * central_mass * period * period / (4.0 * constants.PI * constants.PI)
    return _cbrt(val)
}

# ------------------------------------------------------------
# Luminosity
# ------------------------------------------------------------

# Stefan-Boltzmann luminosity (blackbody sphere): L = 4π·R²·σ·T⁴
# radius (m), temperature (K) → luminosity (W)
fn luminosity(radius, temperature) {
    if radius < 0 {
        return errors.err_negative("radius")
    }
    if temperature < 0 {
        return errors.err_negative("temperature")
    }
    return 4.0 * constants.PI * radius * radius * constants.STEFAN_BOLTZMANN * temperature * temperature * temperature * temperature
}

# Luminosity ratio (relative to Sun): L/L_sun
# luminosity (W) → ratio (dimensionless)
fn luminosity_solar(luminosity_val) {
    if constants.SOLAR_LUMINOSITY == 0 {
        return errors.err_zero("SOLAR_LUMINOSITY")
    }
    return luminosity_val / constants.SOLAR_LUMINOSITY
}

# Absolute magnitude from luminosity (approximate):
# M = M_sun - 2.5·log10(L / L_sun)
# M_sun = 4.74
# luminosity (W) → absolute magnitude
fn absolute_magnitude(luminosity_val) {
    ratio = luminosity_val / constants.SOLAR_LUMINOSITY
    if ratio <= 0 {
        return errors.err_positive("luminosity")
    }
    # log10(ratio) = ln(ratio) / ln(10)
    ln_ratio = _ln(ratio)
    log10_ratio = ln_ratio / 2.302585093
    return 4.74 - 2.5 * log10_ratio
}

# Natural log via series (y > 0)
fn _ln(y) {
    if y <= 0 {
        return 0.0
    }
    t = (y - 1.0) / (y + 1.0)
    t2 = t * t
    result = 0.0
    term = t
    k = 1
    while k <= 21 {
        result = result + term / k
        term = term * t2
        k = k + 2
    }
    return 2.0 * result
}

# ------------------------------------------------------------
# Stellar Mass (mass-luminosity relation)
# ------------------------------------------------------------

# Mass-luminosity relation (main sequence, approximate):
#   L / L_sun = (M / M_sun)^3.5
# Solve for mass: M = M_sun · (L / L_sun)^(1/3.5)
# luminosity (W) → mass (kg)
fn stellarMass(luminosity_val) {
    if luminosity_val <= 0 {
        return errors.err_positive("luminosity")
    }
    ratio = luminosity_val / constants.SOLAR_LUMINOSITY
    # ratio^(1/3.5) = ratio^(2/7)
    # Use exp(ln(ratio) * 2/7)
    ln_ratio = _ln(ratio)
    # Exponential via series: e^x = 1 + x + x²/2! + x³/3! + ...
    x = ln_ratio * 2.0 / 7.0
    exp_val = _exp(x)
    return constants.SOLAR_MASS * exp_val
}

# Exponential via Taylor series
fn _exp(x) {
    result = 1.0
    term = 1.0
    n = 1
    while n <= 30 {
        term = term * x / n
        result = result + term
        n = n + 1
    }
    return result
}

# Inverse: luminosity from mass
# mass (kg) → luminosity (W)
fn luminosity_from_mass(mass) {
    if mass <= 0 {
        return errors.err_positive("mass")
    }
    ratio = mass / constants.SOLAR_MASS
    # ratio^3.5 = exp(3.5 * ln(ratio))
    ln_ratio = _ln(ratio)
    exp_val = _exp(3.5 * ln_ratio)
    return constants.SOLAR_LUMINOSITY * exp_val
}

# ------------------------------------------------------------
# Hubble's Law (cosmology)
# ------------------------------------------------------------

# Hubble's law: v = H₀ · d
# H₀ ≈ 70 km/s/Mpc  =  2.27e-18 s⁻¹
# distance (m) → recession velocity (m/s)
const HUBBLE_CONSTANT = 0.0000000000000000022685

fn hubble_velocity(distance) {
    if distance < 0 {
        return errors.err_negative("distance")
    }
    return HUBBLE_CONSTANT * distance
}

# Distance from recession velocity: d = v / H₀
# velocity (m/s) → distance (m)
fn hubble_distance(velocity) {
    if HUBBLE_CONSTANT == 0 {
        return errors.err_zero("HUBBLE_CONSTANT")
    }
    return velocity / HUBBLE_CONSTANT
}

# ------------------------------------------------------------
# Schwarzschild Radius (Black Holes)
# ------------------------------------------------------------

# Schwarzschild radius: r_s = 2·G·M / c²
# mass (kg) → radius (m)
fn schwarzschild_radius(mass) {
    if mass < 0 {
        return errors.err_negative("mass")
    }
    return 2.0 * constants.GRAVITATIONAL_CONSTANT * mass / (constants.SPEED_OF_LIGHT * constants.SPEED_OF_LIGHT)
}

# Earth Schwarzschild radius
# → radius (m)
fn earth_schwarzschild_radius() {
    return schwarzschild_radius(constants.EARTH_MASS)
}

# Sun Schwarzschild radius
# → radius (m)
fn sun_schwarzschild_radius() {
    return schwarzschild_radius(constants.SOLAR_MASS)
}

# ------------------------------------------------------------
# Apparent Brightness
# ------------------------------------------------------------

# Apparent brightness (flux): b = L / (4π·d²)
# luminosity (W), distance (m) → flux (W/m²)
fn apparent_brightness(luminosity_val, distance) {
    if distance == 0 {
        return errors.err_zero("distance")
    }
    if distance < 0 {
        return errors.err_negative("distance")
    }
    return luminosity_val / (4.0 * constants.PI * distance * distance)
}

# Distance from luminosity and flux: d = √(L / (4π·b))
# luminosity (W), flux (W/m²) → distance (m)
fn distance_from_flux(luminosity_val, flux) {
    if flux == 0 {
        return errors.err_zero("flux")
    }
    if flux < 0 {
        return errors.err_negative("flux")
    }
    return _sqrt(luminosity_val / (4.0 * constants.PI * flux))
}
