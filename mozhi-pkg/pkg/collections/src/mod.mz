# ============================================================
# collections — Data structure helpers for Mozhi (v1.0.0)
# Array operations: sort, filter, map, reduce, reverse, unique
# ============================================================

fn _abs(n) {
    if n < 0 { return -n }
    return n
}

# Length of array
fn len(arr) {
    return arr.len()
}

# Reverse an array
fn reverse(arr) {
    n = arr.len()
    result = []
    i = n - 1
    while i >= 0 {
        result.push(arr[i])
        i = i - 1
    }
    return result
}

# Bubble sort (ascending)
fn sort(arr) {
    n = arr.len()
    i = 0
    while i < n {
        j = 0
        while j < n - i - 1 {
            if arr[j] > arr[j + 1] {
                temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            }
            j = j + 1
        }
        i = i + 1
    }
    return arr
}

# Sort descending
fn sort_desc(arr) {
    n = arr.len()
    i = 0
    while i < n {
        j = 0
        while j < n - i - 1 {
            if arr[j] < arr[j + 1] {
                temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            }
            j = j + 1
        }
        i = i + 1
    }
    return arr
}

# Sum of array elements
fn sum(arr) {
    total = 0
    for x in arr {
        total = total + x
    }
    return total
}

# Find minimum
fn min(arr) {
    if arr.len() == 0 { return 0 }
    m = arr[0]
    for x in arr {
        if x < m { m = x }
    }
    return m
}

# Find maximum
fn max(arr) {
    if arr.len() == 0 { return 0 }
    m = arr[0]
    for x in arr {
        if x > m { m = x }
    }
    return m
}

# Average (mean)
fn mean(arr) {
    if arr.len() == 0 { return 0 }
    return sum(arr) * 1.0 / arr.len()
}

# Contains — check if value exists in array
fn contains(arr, val) {
    for x in arr {
        if x == val { return true }
    }
    return false
}

# Index of first occurrence (returns -1 if not found)
fn index_of(arr, val) {
    i = 0
    while i < arr.len() {
        if arr[i] == val { return i }
        i = i + 1
    }
    return -1
}

# Slice — return sub-array from start to end (exclusive)
fn slice(arr, start, end) {
    if end > arr.len() { end = arr.len() }
    if start < 0 { start = 0 }
    result = []
    i = start
    while i < end {
        result.push(arr[i])
        i = i + 1
    }
    return result
}

# Concat — join two arrays
fn concat(arr1, arr2) {
    result = []
    for x in arr1 { result.push(x) }
    for x in arr2 { result.push(x) }
    return result
}

# Range — create array from start to end (exclusive)
fn range(start, end) {
    result = []
    i = start
    while i < end {
        result.push(i)
        i = i + 1
    }
    return result
}

# Join array elements to string
fn join(arr, sep) {
    result = ""
    i = 0
    while i < arr.len() {
        if i > 0 { result = result + sep }
        result = result + string(arr[i])
        i = i + 1
    }
    return result
}
