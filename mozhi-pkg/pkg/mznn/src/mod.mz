    s = s + "  Multi-Language: Python + C++ + Julia + JS\n"
    s = s + "============================================\n\n"
    s = s + "  Languages:\n"
    s = s + "    Python:      " + PYTHON_SCRIPT + "\n"
    s = s + "    C++:         " + CPP_SCRIPT + "\n"
    s = s + "    JavaScript:  " + JS_SCRIPT + "\n"
    s = s + "    Julia:       " + JULIA_SCRIPT + "\n\n"
    s = s + "  Features:\n"
    s = s + "    - Feedforward MLP\n"
    s = s + "    - Backpropagation\n"
    s = s + "    - sigmoid, tanh, relu, softmax\n"
    s = s + "    - MSE, cross-entropy loss\n"
    s = s + "    - Save/Load (JSON)\n"
    s = s + "    - Auto-download from GitHub\n\n"
    s = s + "  Usage:\n"
    s = s + "    mod.demo()       # Python XOR\n"
    s = s + "    mod.demo_cpp()   # C++ XOR\n"
    s = s + "    mod.demo_js()    # JS XOR\n"
    s = s + "    mod.demo_julia() # Julia XOR\n"
    s = s + "    mod.demo_all()   # All available\n"
    s = s + "    mod.train('data.csv', '2 4 1', 1000, 'model.json')\n"
    s = s + "    mod.predict('model.json', '0.5,0.3')\n"
