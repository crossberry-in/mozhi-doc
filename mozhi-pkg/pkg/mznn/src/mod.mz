}

# ============================================================
# Full Pipeline
# ============================================================

fn run_xor_pipeline() {
    echo("=== mznn: Full XOR Pipeline ===")
    echo("")
    
    # 1. Create data
    echo("--- Step 1: Create XOR data ---")
    data_path = create_xor_data()
    
    # 2. Train
    echo("")
    echo("--- Step 2: Train model ---")
    train(data_path, "2 4 1", 1000, "/tmp/mznn_xor_model.json")
    
    # 3. Predict
    echo("")
    echo("--- Step 3: Predict ---")
    predict("/tmp/mznn_xor_model.json", "0,0")
    predict("/tmp/mznn_xor_model.json", "0,1")
    predict("/tmp/mznn_xor_model.json", "1,0")
    predict("/tmp/mznn_xor_model.json", "1,1")
    
    echo("")
    echo("=== Pipeline complete! ===")
}
