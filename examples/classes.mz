# Classes in Mozhi v2.0+

class Person:
    fn init(self, name, age):
        self.name = name
        self.age = age

    fn greet(self):
        echo("Hi, I'm " + self.name)

    fn birthday(self):
        self.age = self.age + 1
        echo(self.name + " is now " + string(self.age))

# Create instances
alice = Person("Alice", 30)
bob = Person("Bob", 25)

# Call methods
alice.greet()
bob.greet()

# Birthday
alice.birthday()
alice.birthday()

echo("")
echo("Alice age: " + string(alice.age))
echo("Bob age: " + string(bob.age))
