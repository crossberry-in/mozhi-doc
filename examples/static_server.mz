# ============================================================
# Static File Server — v2.4.0
# Serves static files from a public/ directory
# ============================================================

import http from "mozhi-http"

# Create public/ directory with sample files
fn setup() {
    run("mkdir -p public")

    if not file_exists("public/index.html") {
        write_file("public/index.html", "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Mozhi Static Server</title>\n  <link rel=\"stylesheet\" href=\"/style.css\">\n</head>\n<body>\n  <h1>Hello from Mozhi!</h1>\n  <p>This page is served from <code>public/index.html</code></p>\n  <h2>Files</h2>\n  <ul>\n    <li><a href=\"/\">index.html</a> - This page</li>\n    <li><a href=\"/style.css\">style.css</a> - Stylesheet</li>\n    <li><a href=\"/about.html\">about.html</a> - About page</li>\n    <li><a href=\"/data.json\">data.json</a> - JSON data</li>\n  </ul>\n</body>\n</html>")
    }

    if not file_exists("public/style.css") {
        write_file("public/style.css", "body { font-family: -apple-system, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; color: #333; }\nh1 { color: #2563eb; }\ncode { background: #f3f4f6; padding: 2px 6px; border-radius: 3px; }\na { color: #2563eb; }\nul { line-height: 1.8; }")
    }

    if not file_exists("public/about.html") {
        write_file("public/about.html", "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <title>About - Mozhi</title>\n  <link rel=\"stylesheet\" href=\"/style.css\">\n</head>\n<body>\n  <h1>About</h1>\n  <p>Mozhi is a programming language with a tree-walking interpreter.</p>\n  <p><a href=\"/\">&larr; Back to Home</a></p>\n</body>\n</html>")
    }

    if not file_exists("public/data.json") {
        write_file("public/data.json", "{\n  \"name\": \"Mozhi\",\n  \"version\": \"2.4.0\",\n  \"features\": [\"file-io\", \"shell\", \"http\", \"imports\"]\n}")
    }
}

setup()

fn handler(method, path) {
    echo("[" + method + "] " + path)
    # http_serve_static automatically:
    #   - serves index.html for "/"
    #   - serves style.css for "/style.css"
    #   - serves about.html for "/about.html"
    #   - returns 404 for missing files
    #   - guesses content type from extension
    return http.http_serve_static(path, "public")
}

echo("=== Mozhi Static File Server ===")
echo("Serving files from public/ directory")
echo("URL: http://localhost:8080")
echo("")
echo("Files available:")
echo(run("ls -la public/"))
echo("")
echo("Press Ctrl+C to stop")
echo("")

server = http.http_start(8080)
http.http_serve_loop(server, handler)
