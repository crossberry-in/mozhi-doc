# Match statement in Mozhi v2.0+

echo("=== Match Statement ===")

# Match with numbers
x = 2
echo("Matching x = " + string(x) + ":")
match x {
    1 => echo("  One")
    2 => echo("  Two")
    3 => echo("  Three")
    _ => echo("  Other")
}

# Match with strings
day = "Tuesday"
echo("")
echo("Matching day = '" + day + "':")
match day {
    "Monday" => echo("  Start of work week")
    "Tuesday" => echo("  Second day")
    "Wednesday" => echo("  Hump day")
    "Thursday" => echo("  Almost there")
    "Friday" => echo("  TGIF!")
    _ => echo("  Weekend!")
}

# Match with default
status = 404
echo("")
echo("Matching HTTP status " + string(status) + ":")
match status {
    200 => echo("  OK")
    301 => echo("  Moved Permanently")
    404 => echo("  Not Found")
    500 => echo("  Internal Server Error")
    _ => echo("  Unknown status")
}
