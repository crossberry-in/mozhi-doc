# Mozhi v2.0 — Hello World
# New syntax with { } braces, no var keyword, fn, const

echo("Hello, World!")

# Variables (type inferred)
name = "Mozhi"
age = 20
price = 99.99
active = true

echo(name, " is ", age, " years old")

# Constants
const PI = 3.14159
echo("PI = ", PI)

# If / Else
if age >= 18 {
    echo("Adult")
} else {
    echo("Minor")
}

# While loop
i = 0
while i < 5 {
    echo("i = ", i)
    i += 1
}

# For loop (C-style)
for j = 0; j < 3; j += 1 {
    echo("j = ", j)
}

# For-in loop
fruits = ["apple", "banana", "cherry"]
for fruit in fruits {
    echo(fruit)
}

# Functions
fn add(a, b) {
    return a + b
}

echo("3 + 4 = ", add(3, 4))

# Recursive function
fn factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

echo("5! = ", factorial(5))

# Match
x = 2
match x {
    1 => echo("One")
    2 => echo("Two")
    3 => echo("Three")
    _ => echo("Other")
}

# Multi-line comment
/* This is a
   multi-line comment */
echo("After comment")

# Fibonacci
fn fibonacci(n) {
    if n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

echo("Fibonacci(10) = ", fibonacci(10))
