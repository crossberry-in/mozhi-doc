# Math operations in Mozhi v2.0+

echo("=== Math Operations ===")

# Basic arithmetic
echo("Basic:")
echo("  10 + 5 = " + string(10 + 5))
echo("  10 - 5 = " + string(10 - 5))
echo("  10 * 5 = " + string(10 * 5))
echo("  10 / 3 = " + string(10 / 3))
echo("  10 % 3 = " + string(10 % 3))

# Built-in math functions
echo("")
echo("Built-in functions:")
echo("  sqrt(144) = " + string(sqrt(144)))
echo("  sqrt(2) = " + string(sqrt(2)))
echo("  abs(-42) = " + string(abs(-42)))
echo("  abs(42) = " + string(abs(42)))
echo("  floor(3.7) = " + string(floor(3.7)))
echo("  ceil(3.2) = " + string(ceil(3.2)))

# Constants
echo("")
echo("Constants:")
const PI = 3.141592653589793
const E = 2.718281828459045
echo("  PI = " + string(PI))
echo("  E = " + string(E))

# Compound assignment
echo("")
echo("Compound assignment:")
n = 10
n += 5
echo("  n += 5: " + string(n))
n -= 3
echo("  n -= 3: " + string(n))
n *= 2
echo("  n *= 2: " + string(n))
n /= 4
echo("  n /= 4: " + string(n))

# Using math library
echo("")
echo("=== Math Library ===")
import math_utils from "mozhi-math-utils"
echo("  factorial(10) = " + string(math_utils.factorial(10)))
echo("  fibonacci(20) = " + string(math_utils.fibonacci(20)))
echo("  gcd(48, 36) = " + string(math_utils.gcd(48, 36)))
echo("  is_prime(97) = " + string(math_utils.is_prime(97)))
