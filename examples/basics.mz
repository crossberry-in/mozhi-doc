# Basic examples in Mozhi v2.0+
# Variables (no var keyword — just assign)
num = 42
pi = 3.14159
str = "Hello, Mozhi!"
flag = true
nothing = null

echo("Integer: " + string(num))
echo("Float: " + string(pi))
echo("String: " + str)
echo("Boolean: " + string(flag))
echo("Null: " + string(nothing))

# Arithmetic
echo("")
echo("=== Arithmetic ===")
echo("10 + 5 = " + string(10 + 5))
echo("10 - 5 = " + string(10 - 5))
echo("10 * 5 = " + string(10 * 5))
echo("10 / 5 = " + string(10 / 5))
echo("10 % 3 = " + string(10 % 3))

# Comparison
echo("")
echo("=== Comparison ===")
echo("5 > 3: " + string(5 > 3))
echo("5 < 3: " + string(5 < 3))
echo("5 == 5: " + string(5 == 5))
echo("5 != 5: " + string(5 != 5))

# Logical
echo("")
echo("=== Logical ===")
echo("true and false: " + string(true and false))
echo("true or false: " + string(true or false))
echo("not true: " + string(not true))

# Strings
echo("")
echo("=== Strings ===")
greeting = "Hello" + ", " + "World!"
echo(greeting)
echo("Length: " + string(greeting.len()))
echo("Upper: " + greeting.upper())
echo("Lower: " + greeting.lower())

# Arrays
echo("")
echo("=== Arrays ===")
arr = [10, 20, 30, 40, 50]
echo("Length: " + string(arr.len()))
echo("First: " + string(arr[0]))
echo("Last: " + string(arr[4]))

arr.push(60)
echo("After push(60): length = " + string(arr.len()))

last = arr.pop()
echo("Popped: " + string(last))

# Functions
echo("")
echo("=== Functions ===")
fn square(x) {
    return x * x
}

echo("square(5) = " + string(square(5)))
echo("square(10) = " + string(square(10)))

# For-in loop
echo("")
echo("=== For-in Loop ===")
fruits = ["apple", "banana", "cherry"]
for fruit in fruits {
    echo("  " + fruit)
}

# If/Else
echo("")
echo("=== If/Else ===")
age = 20
if age >= 18 {
    echo("Adult")
} else {
    echo("Minor")
}

# While loop
echo("")
echo("=== While Loop ===")
i = 0
while i < 5 {
    echo("  i = " + string(i))
    i = i + 1
}
