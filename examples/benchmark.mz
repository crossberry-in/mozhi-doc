# ============================================================
# Benchmark Example — v2.4.0
# Measure Mozhi performance for common operations
# ============================================================

echo("=== Mozhi Benchmark ===")
echo("")

# Fibonacci benchmark
echo("--- Fibonacci ---")
i = 0
while i < 5 {
    n = 25
    start = run("date +%s%N")
    result = 0
    a = 0
    b = 1
    j = 2
    while j <= n {
        c = a + b
        a = b
        b = c
        j = j + 1
    }
    result = b
    end = run("date +%s%N")
    echo("  fib(" + string(n) + ") = " + string(result))
    i = i + 1
}
echo("")

# Loop benchmark
echo("--- Loop: 1 to 10,000,000 ---")
start = run("date +%s%N")
total = 0
i = 1
while i <= 1000000 {
    total = total + i
    i = i + 1
}
end = run("date +%s%N")
echo("  Sum = " + string(total))
echo("")

# String benchmark
echo("--- String: 1000 concatenations ---")
start = run("date +%s%N")
s = ""
i = 0
while i < 1000 {
    s = s + "x"
    i = i + 1
}
end = run("date +%s%N")
echo("  String length: " + string(s.len()))
echo("")

# Array benchmark
echo("--- Array: 1000 pushes ---")
start = run("date +%s%N")
arr = []
i = 0
while i < 1000 {
    arr.push(i)
    i = i + 1
}
end = run("date +%s%N")
echo("  Array length: " + string(arr.len()))
echo("")

# Shell call benchmark
echo("--- Shell: 10 run() calls ---")
start = run("date +%s%N")
i = 0
while i < 10 {
    run("echo 'test' > /dev/null")
    i = i + 1
}
end = run("date +%s%N")
echo("  10 shell calls completed")
echo("")

echo("=== Benchmark Complete ===")
echo("Run with: mozhi-interpreter benchmark.mz")
