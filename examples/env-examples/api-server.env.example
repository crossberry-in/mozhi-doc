# ═══════════════════════════════════════════════════════════
# pkgs-mz API Server — Environment Variables
# ═══════════════════════════════════════════════════════════

# ── GitHub Authentication ──────────────────────────────────
# GitHub Personal Access Token for API access
# Required for: pushing packages, reading private repos
# Scopes needed: repo, read:user
GITHUB_TOKEN=ghp_YourTokenHere

# GitHub repository for package storage
GITHUB_OWNER=crossberry-in
GITHUB_REPO=mozhi-doc

# ── Server Configuration ──────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ── API Security ──────────────────────────────────────────
# API key for protected endpoints
# Users must include: X-API-Key: <this-key>
API_SECRET_KEY=your-secret-api-key-here

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── Cache ─────────────────────────────────────────────────
CACHE_TTL=300
CACHE_MAX_SIZE=1000
