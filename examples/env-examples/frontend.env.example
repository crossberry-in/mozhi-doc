# ═══════════════════════════════════════════════════════════
# pkgs-mz Frontend — Environment Variables
# ═══════════════════════════════════════════════════════════

# ── Backend API URL ───────────────────────────────────────
# URL of the pkgs-mz API server
NEXT_PUBLIC_API_URL=http://localhost:3000

# For production deployment:
# NEXT_PUBLIC_API_URL=https://pkgs-mz.vercel.app

# ── Feature Flags ─────────────────────────────────────────
NEXT_PUBLIC_ENABLE_AUTH=true
NEXT_PUBLIC_ENABLE_SEARCH=true
NEXT_PUBLIC_ENABLE_PACKAGES=true

# ── Analytics (optional) ──────────────────────────────────
# NEXT_PUBLIC_ANALYTICS_ID=UA-XXXXXXXXX-X
