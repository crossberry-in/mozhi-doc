# ═══════════════════════════════════════════════════════════
# js-sdk — JavaScript/NPM Interop Configuration
# ═══════════════════════════════════════════════════════════

# ── Module Resolution ─────────────────────────────────────
# Node modules search path
NODE_PATH=./node_modules

# ── Security ──────────────────────────────────────────────
# Restrict which npm packages can be imported
# Comma-separated list of allowed packages
ALLOWED_NPM_PACKAGES=lodash,express,axios

# Allow all node built-ins
ALLOW_NODE_BUILTINS=true

# ── Performance ───────────────────────────────────────────
# Enable module caching
ENABLE_CACHE=true

# Cache TTL in seconds
CACHE_TTL=3600

# ── Debug ─────────────────────────────────────────────────
# Enable debug logging
DEBUG=false

# Log module loads
LOG_MODULE_LOADS=false
