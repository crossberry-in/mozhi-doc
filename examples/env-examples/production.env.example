# ═══════════════════════════════════════════════════════════
# Production Environment — Production Deployment
# ═══════════════════════════════════════════════════════════

# ── GitHub (Production token with full scope) ─────────────
GITHUB_TOKEN=ghp_ProductionTokenHere

# ── Server ────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# ── API Security ──────────────────────────────────────────
# Strong random API key
API_SECRET_KEY=very-long-random-secret-key-change-this

# ── Logging (minimal in production) ───────────────────────
LOG_LEVEL=warn
LOG_FORMAT=json

# ── Cache (enabled in production) ─────────────────────────
CACHE_TTL=300
CACHE_MAX_SIZE=10000

# ── CORS (restrict in production) ─────────────────────────
CORS_ORIGIN=https://your-domain.com

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
