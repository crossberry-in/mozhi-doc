# ═══════════════════════════════════════════════════════════
# Development Environment — Local Development
# ═══════════════════════════════════════════════════════════

# ── GitHub (Use test token with limited scope) ────────────
GITHUB_TOKEN=ghp_TestTokenForDevOnly

# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Logging (verbose in dev) ──────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ── Cache (disabled in dev) ───────────────────────────────
CACHE_TTL=0

# ── CORS (allow all in dev) ──────────────────────────────
CORS_ORIGIN=*

# ── Rate Limiting (disabled in dev) ───────────────────────
RATE_LIMIT_ENABLED=false
