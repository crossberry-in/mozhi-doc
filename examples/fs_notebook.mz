# ============================================================
# Filesystem Module — sandboxed file operations
#
# Run:  mozhi run examples/fs_notebook.mz
#
# Every path is resolved against the sandbox root (the working
# directory at startup). `..` is rejected and symlink escapes
# are verified with realpath(), so file access stays inside
# the sandbox. An escaping path raises a runtime error that
# stops the program — never write through untrusted paths.
# ============================================================

import fs

echo("sandbox root: " + fs.get_root())

# ---- write / read / append ----
fs.write("notebook.txt", "line 1: Mozhi keeps file access sandboxed\n")
fs.append("notebook.txt", "line 2: paths cannot escape the root\n")

let content = fs.read("notebook.txt")
echo(content)
assert(content.contains("sandboxed"), "write/read roundtrip")

# ---- exists and stat ----
assert(fs.exists("notebook.txt"), "file exists")
let info = fs.stat("notebook.txt")
echo("type: " + info.type + "  size: " + string(info.size) + " bytes")

# ---- nested directories ----
fs.mkdir("notes/2026/10")
fs.write("notes/2026/10/today.txt", "shipped the web server")
assert_eq(fs.read("notes/2026/10/today.txt"), "shipped the web server", "nested write")

# ---- list: entries are maps {name, type, size} ----
let entries = fs.list("notes/2026/10")
for entry in entries {
    echo("- " + entry.name + " (" + entry.type + ", " + string(entry.size) + "b)")
}

# ---- cleanup: recursive removal is explicit opt-in ----
assert(fs.remove("notebook.txt"), "remove single file")
assert(fs.remove("notes", true), "recursive remove needs true")
assert(fs.exists("notes") == false, "directory gone")

# removing something that does not exist returns false (no error)
assert_eq(fs.remove("notebook.txt"), false, "remove missing returns false")

# ---- safe filename handling from user input ----
# Never build paths from raw input without a check: reject
# anything containing separators or ".." before it reaches fs.
fn safe_name(input) {
    if input.contains("..") or input.contains("/") {
        return null
    }
    return input
}

let wanted = safe_name("report.txt")
if wanted != null {
    fs.write(wanted, "created after validation")
    assert(fs.exists("report.txt"), "validated name written")
    fs.remove("report.txt")
}
echo("rejected name: " + string(safe_name("../evil") == null))

echo("fs_notebook.mz OK")
