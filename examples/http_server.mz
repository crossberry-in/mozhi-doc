# ============================================================
# HTTP Server Example — v2.4.0
# A basic HTTP server with multiple routes
# ============================================================

import http from "mozhi-http"
import html from "mozhi-html"

fn handler(method, path) {
    echo("[" + method + "] " + path)

    # Strip query string
    route = path
    if path.contains("?") {
        route = path.split("?")[0]
    }

    # Route: /
    if route == "/" {
        body = html.html_page("Mozhi Server",
            html.html_h1("Welcome to Mozhi HTTP Server") +
            html.html_p("This server is running Mozhi v2.4.0.") +
            html.html_h2("Routes") +
            html.html_ul([
                "GET / - This page",
                "GET /about - About page",
                "GET /api - JSON API",
                "GET /echo?msg=hello - Echo endpoint"
            ])
        )
        return http.http_ok_html(body)
    }

    # Route: /about
    if route == "/about" {
        body = html.html_page("About",
            html.html_h1("About Mozhi") +
            html.html_p("Mozhi is a programming language with a tree-walking interpreter.") +
            html.html_p("This page was generated by Mozhi code.")
        )
        return http.http_ok_html(body)
    }

    # Route: /api (JSON)
    if route == "/api" {
        json_resp = "{\"name\": \"Mozhi\", \"version\": \"2.4.0\", \"routes\": [\"/\", \"/about\", \"/api\", \"/echo\"]}"
        return http.http_ok_json(json_resp)
    }

    # Route: /echo?msg=hello
    if route == "/echo" {
        msg = http.http_query_param(path, "msg")
        if msg == "" {
            msg = "no message provided"
        }
        return http.http_ok_json("{\"echo\": \"" + msg + "\"}")
    }

    # 404
    body = html.html_page("404",
        html.html_h1("404 Not Found") +
        html.html_p("The page " + path + " was not found.") +
        html.html_a("/", "Go Home")
    )
    return http.http_404(body)
}

echo("Starting Mozhi HTTP Server on port 8080...")
server = http.http_start(8080)
echo("Server running at http://localhost:8080")
echo("Press Ctrl+C to stop")
echo("")
http.http_serve_loop(server, handler)
