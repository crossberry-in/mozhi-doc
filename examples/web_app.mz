# ============================================================
# Complete Web App — v2.4.0
# Combines: static files + JSON API + multi-language run
# ============================================================

import http from "mozhi-http"
import html from "mozhi-html"

# Setup: create directories and files
fn setup() {
    run("mkdir -p public scripts")

    if not file_exists("public/index.html") {
        write_file("public/index.html", "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Mozhi Web App</title>\n  <link rel=\"stylesheet\" href=\"/style.css\">\n</head>\n<body>\n  <h1>Mozhi Web App</h1>\n  <p>Welcome to a full-featured Mozhi web application!</p>\n\n  <h2>Static Files</h2>\n  <ul>\n    <li><a href=\"/style.css\">/style.css</a></li>\n    <li><a href=\"/about.html\">/about.html</a></li>\n  </ul>\n\n  <h2>API Endpoints</h2>\n  <ul>\n    <li><a href=\"/api/info\">GET /api/info</a></li>\n    <li><a href=\"/api/files\">GET /api/files</a></li>\n    <li><a href=\"/api/time\">GET /api/time</a></li>\n  </ul>\n\n  <h2>Multi-Language Run</h2>\n  <ul>\n    <li><a href=\"/run/c\">/run/c</a> — Compile & run C</li>\n    <li><a href=\"/run/py\">/run/py</a> — Run Python</li>\n    <li><a href=\"/run/sh\">/run/sh</a> — Run Shell</li>\n    <li><a href=\"/run/mz\">/run/mz</a> — Run Mozhi</li>\n  </ul>\n</body>\n</html>")
    }

    if not file_exists("public/style.css") {
        write_file("public/style.css", "body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; max-width: 800px; margin: 2rem auto; padding: 0 1rem; color: #1f2937; }\nh1 { color: #2563eb; border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem; }\nh2 { color: #7c3aed; margin-top: 2rem; }\nul { line-height: 1.8; }\na { color: #2563eb; text-decoration: none; }\na:hover { text-decoration: underline; }\ncode { background: #f3f4f6; padding: 2px 6px; border-radius: 4px; font-family: monospace; }")
    }

    if not file_exists("public/about.html") {
        write_file("public/about.html", "<!DOCTYPE html>\n<html>\n<head><link rel=\"stylesheet\" href=\"/style.css\"></head>\n<body>\n  <h1>About</h1>\n  <p>Mozhi v2.4.0 — a programming language with file I/O, shell, and multi-language run builtins.</p>\n  <p><a href=\"/\">&larr; Home</a></p>\n</body>\n</html>")
    }

    # Create script files
    if not file_exists("scripts/demo.c") {
        write_file("scripts/demo.c", "#include <stdio.h>\nint main() {\n    printf(\"Hello from C!\\n\");\n    int sum = 0;\n    for (int i = 1; i <= 10; i++) sum += i;\n    printf(\"Sum 1..10 = %d\\n\", sum);\n    return 0;\n}")
    }
    if not file_exists("scripts/demo.py") {
        write_file("scripts/demo.py", "import sys\nprint('Hello from Python!')\nprint(f'Python {sys.version}')\nprint(f'2 ** 10 = {2 ** 10}')")
    }
    if not file_exists("scripts/demo.sh") {
        write_file("scripts/demo.sh", "#!/bin/bash\necho 'Hello from Shell!'\necho \"Date: $(date)\"\necho \"User: $(whoami)\"")
    }
    if not file_exists("scripts/demo.mz") {
        write_file("scripts/demo.mz", "echo(\"Hello from Mozhi!\")\necho(\"7 * 8 = \" + string(7 * 8))")
    }
}

setup()

# HTTP handler
fn handler(method, path) {
    echo("[" + method + "] " + path)

    route = path
    if path.contains("?") {
        route = path.split("?")[0]
    }

    # API: /api/info
    if route == "/api/info" {
        return http.http_ok_json("{\"name\": \"Mozhi Web App\", \"version\": \"2.4.0\", \"features\": [\"static-files\", \"api\", \"multi-language\"]}")
    }

    # API: /api/files — list files in public/
    if route == "/api/files" {
        files = list_dir("public")
        out = "{\"files\": ["
        i = 0
        for f in files {
            if i > 0 {
                out = out + ", "
            }
            out = out + "\"" + f + "\""
            i = i + 1
        }
        out = out + "]}"
        return http.http_ok_json(out)
    }

    # API: /api/time — current time
    if route == "/api/time" {
        t = run("date")
        return http.http_ok_json("{\"time\": \"" + t.trim() + "\"}")
    }

    # Multi-language: /run/c
    if route == "/run/c" {
        return http.http_run_c("scripts/demo.c")
    }

    # Multi-language: /run/py
    if route == "/run/py" {
        return http.http_run_py("scripts/demo.py")
    }

    # Multi-language: /run/sh
    if route == "/run/sh" {
        return http.http_run_sh("scripts/demo.sh")
    }

    # Multi-language: /run/mz
    if route == "/run/mz" {
        return http.http_run_mz("scripts/demo.mz")
    }

    # Static files from public/
    return http.http_serve_static(route, "public")
}

echo("============================================")
echo("  Mozhi Web App v2.4.0")
echo("  http://localhost:8080")
echo("============================================")
echo("")
echo("Static files:  /, /style.css, /about.html")
echo("API:           /api/info, /api/files, /api/time")
echo("Multi-language: /run/c, /run/py, /run/sh, /run/mz")
echo("")
echo("Press Ctrl+C to stop")
echo("")

server = http.http_start(8080)
http.http_serve_loop(server, handler)
