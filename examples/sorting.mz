# Sorting algorithms in Sino

func bubble_sort(arr):
    var n = len(arr)
    for var i = 0; i < n - 1; i = i + 1:
        for var j = 0; j < n - i - 1; j = j + 1:
            if arr[j] > arr[j + 1]:
                var temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            end
        end
    end
    return arr
end

func print_array(arr):
    var result = "["
    for var i = 0; i < len(arr); i = i + 1:
        result = result + string(arr[i])
        if i < len(arr) - 1:
            result = result + ", "
        end
    end
    result = result + "]"
    return result
end

var data = [64, 34, 25, 12, 22, 11, 90]
echo "Original: ", print_array(data)
echo "Sorted: ", print_array(bubble_sort(data))
