# ============================================================
# Testing — the assert-based test file pattern
#
# Run:  mozhi run examples/app_tests.mz
#   or: mozhi test            (from a project with mozhi.toml)
#
# Tests are plain Mozhi files using the assert family of
# builtins. A file passes when it runs to completion; a failed
# assertion stops it with a non-zero exit code.
# ============================================================

# ---- the code under test ----
fn fib(n) {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn slugify(title) {
    let s = title.trim().lower()
    let out = ""
    let i = 0
    while i < s.len() {
        let ch = s.slice(i, i + 1)
        if ch == " " {
            out = out + "-"
        } else {
            out = out + ch
        }
        i = i + 1
    }
    return out
}

fn average(nums) {
    if nums.len() == 0 {
        return 0
    }
    let total = 0
    for n in nums {
        total = total + n
    }
    return total / nums.len()
}

# ---- assertions ----
assert_eq(fib(0), 0, "fib base case")
assert_eq(fib(1), 1, "fib base case 2")
assert_eq(fib(10), 55, "fib recursion")

assert_eq(slugify("  Hello Mozhi World "), "hello-mozhi-world", "slugify trims and joins")
assert_eq(average([2, 4, 6]), 4, "average of evens")
assert_eq(average([]), 0, "average of empty is 0")

assert("mozhi".contains("oz"), "contains works")
assert_ne("a" + "b", "c", "concat is not magic")
assert_null(null, "null is null")

# ---- grouping with functions keeps failures readable ----
fn test_string_methods() {
    assert_eq("abc".upper(), "ABC", "upper")
    assert_eq("ABC".lower(), "abc", "lower")
    assert_eq("abcdef".slice(1, 3), "bc", "slice is start-inclusive, end-exclusive")
    assert_eq("a-b-c".split("-").len(), 3, "split count")
}
test_string_methods()

# ---- timing: keep suites fast ----
let started = clock_ms()
fib(20)
let elapsed = clock_ms() - started
echo("fib(20) took " + string(elapsed) + "ms")
assert(elapsed < 5000, "fib(20) stays fast")

echo("app_tests.mz OK")
