import react from "react.mz"
echo(react.div("class=\"card\"", react.h2("", "Todo List") + "<input type='text' id='todo' placeholder='Add todo...' style='margin-right:0.5rem;'><button class='btn' onclick='addTodo()'>Add</button><ul id='list' style='list-style:none;margin-top:1rem;'></ul>" + "<script>function addTodo(){var i=document.getElementById('todo');var t=i.value.trim();if(!t)return;var l=document.createElement('li');l.style.cssText='padding:0.5rem;border-bottom:1px solid #30363d;display:flex;justify-content:space-between;';l.innerHTML='<span>'+t+'</span><button class=\"btn btn-red\" style=\"padding:2px 8px;font-size:0.8rem;\" onclick=\"this.parentElement.remove()\">x</button>';document.getElementById('list').appendChild(l);i.value='';}</script>"))