# ============================================================
# Mozhi Web Server Example
# Demonstrates using mozhi-http and mozhi-html libraries together
# ============================================================

import http from "mozhi-http"
import html from "mozhi-html"
import strings from "mozhi-strings"

# --- Build the home page ---
fn render_home() {
    title = "Mozhi Web Server"
    h1 = html.html_h1("Welcome to Mozhi")
    p = html.html_p("A modern programming language built from scratch.")
    hero = html.html_div("hero", h1 + p)

    feat = "<ul>"
    feat = feat + "<li>Tree-walking interpreter in C</li>"
    feat = feat + "<li>Cross-platform binaries via Zig</li>"
    feat = feat + "<li>Beautiful TUI in Go</li>"
    feat = feat + "<li>Library package system with imports</li>"
    feat = feat + "<li>GitHub Actions CI/CD</li>"
    feat = feat + "</ul>"

    h2 = html.html_h2("Features")
    features_div = html.html_div("features", h2 + feat)
    body = hero + features_div

    link = html.html_a("https://github.com/crossberry-in/mozhi", "Mozhi")
    footer_text = "Built with " + link + " v2.0"
    footer = html.html_footer(html.html_p(footer_text))

    css = "body { font-family: sans-serif; max-width: 720px; margin: 0 auto; padding: 2rem; } h1, h2 { color: #58a6ff; } a { color: #58a6ff; }"
    style = html.html_style(css)

    return html.html_page(title, style + body + footer)
}

# --- Build the about page ---
fn render_about() {
    h1 = html.html_h1("About Mozhi")
    p1 = html.html_p("Mozhi is a complete programming language ecosystem built from scratch.")
    p2 = html.html_p("This page is served by the Mozhi interpreter.")
    body = h1 + p1 + p2
    return html.html_page("About", body)
}

# --- Build the API JSON response ---
fn render_api_info() {
    return http.http_ok_json("{\"name\": \"Mozhi\", \"version\": \"2.0.0\"}")
}

# --- Echo endpoint ---
fn render_echo(path) {
    msg = http.http_query_param(path, "msg")
    if msg == "" {
        msg = "no msg"
    }
    return http.http_ok_json("{\"echo\": \"" + msg + "\"}")
}

# --- HTTP request handler ---
fn handler(method, path) {
    route = path
    if path.contains("?") {
        route = path.split("?")[0]
    }
    if route == "/" {
        return http.http_ok_html(render_home())
    }
    if route == "/about" {
        return http.http_ok_html(render_about())
    }
    if route == "/api" {
        return render_api_info()
    }
    if strings.starts_with(route, "/echo") {
        return render_echo(path)
    }
    return http.http_404("not found")
}

# --- Main ---
fn main() {
    echo("Mozhi Web Server starting on port 8080")
    server = http.http_start(8080)
    http.http_serve_loop(server, handler)
}

main()
